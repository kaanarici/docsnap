{
	"name": "docsnap",
	"version": "0.1.6",
	"description": "Browser-free CLI that turns public docs and text-heavy pages into clean Markdown corpora for AI agents.",
	"license": "MIT",
	"author": "Kaan Aricioglu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kaanarici/docsnap.git"
	},
	"bugs": {
		"url": "https://github.com/kaanarici/docsnap/issues"
	},
	"homepage": "https://github.com/kaanarici/docsnap#readme",
	"keywords": [
		"docs",
		"documentation",
		"markdown",
		"corpus",
		"cli",
		"browser-free",
		"static-fetch",
		"agent",
		"ai",
		"llms",
		"mcp"
	],
	"type": "module",
	"packageManager": "bun@1.3.11",
	"engines": {
		"bun": ">=1.3.0"
	},
	"bin": {
		"docsnap": "bin/docsnap"
	},
	"files": [
		"bin",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"check": "bun run lint && bun run typecheck && bun run test && bun run size",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"size": "bun scripts/size.ts",
		"publish:dry": "bun pm pack --dry-run"
	},
	"dependencies": {
		"defuddle": "^0.19.0",
		"linkedom": "^0.18.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/bun": "1.3.13",
		"typescript": "^5.9.3"
	}
}
