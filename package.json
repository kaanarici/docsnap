{
	"name": "docsnap",
	"version": "2.0.0",
	"description": "Save public documentation as Markdown and search it locally.",
	"license": "MIT",
	"author": "Kaan Aricioglu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kaanarici/docsnap.git"
	},
	"bugs": {
		"url": "https://github.com/kaanarici/docsnap/issues"
	},
	"homepage": "https://github.com/kaanarici/docsnap#readme",
	"keywords": [
		"docs",
		"documentation",
		"markdown",
		"corpus",
		"cli",
		"agent",
		"grep",
		"hash-verified",
		"web-crawler",
		"web-scraper"
	],
	"type": "module",
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.4.0"
	},
	"bin": {
		"docsnap": "dist/entry.ts"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bun scripts/build.ts",
		"check": "bun run lint && bun run typecheck && bun run test && bun run size && bun run build",
		"lint": "biome check . && oxlint .",
		"test": "bun test --max-concurrency=1",
		"typecheck": "tsc --noEmit",
		"size": "bun scripts/size.ts",
		"prepack": "bun run build",
		"publish:dry": "bun pm pack --dry-run"
	},
	"dependencies": {
		"@firecrawl/anydoc": "0.1.9",
		"defuddle": "0.19.3",
		"linkedom": "0.18.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@oxlint/plugins": "1.78.0",
		"@types/bun": "1.4.0",
		"oxlint": "1.78.0",
		"typescript": "^5.9.3"
	}
}
